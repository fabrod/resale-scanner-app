# Copy to .env and fill in. Never commit .env.
PORT=3001

# Paid upcitemdb key (optional — without it the free trial tier is used)
UPCITEMDB_KEY=

# Sold-price data: CompsAPI — free key (100 req/mo, no card) at https://app.compsapi.com
# Paid plans from $9 when you scan real volume.
SOLD_API_URL=https://api.compsapi.com
SOLD_API_KEY=
