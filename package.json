{
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^57.0.30",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "main": "index.js",
  "name": "resale-scanner",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "backend": "npm --prefix backend start",
    "test": "node --test tests/*.test.cjs",
    "camera:fixture": "node scripts/generate-camera-fixture.cjs",
    "test:e2e": "npm run camera:fixture && cypress run --browser chrome --spec cypress/e2e/camera.cy.js",
    "test:e2e:live": "npm run camera:fixture && cypress run --browser chrome --spec cypress/e2e/live-api.cy.js"
  },
  "version": "1.0.0",
  "devDependencies": {
    "babel-preset-expo": "~57.0.0",
    "cypress": "^16.2.0"
  }
}
